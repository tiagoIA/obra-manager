rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function legacyUser() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && !firestore.exists(/databases/(default)/documents/userCompanies/$(request.auth.uid));
    }
    match /{folder}/{allPaths=**} {
      allow read, write: if legacyUser() && folder != 'estimateFiles';
    }
    match /estimateFiles/{uid}/{estimateId}/{fileId} {
      allow read: if legacyUser() && (request.auth.uid == uid || resource.metadata.reviewOwner == request.auth.uid);
      allow delete: if legacyUser() && request.auth.uid == uid;
      allow create, update: if legacyUser() && request.auth.uid == uid
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType.matches('(image|video|audio)/.*|application/pdf');
    }
  }
}