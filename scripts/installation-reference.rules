    // Central installation guides: same readers/editors as the material library.
    match /installationReferences/{guideId} {
      function validGuide() {
        let d = request.resource.data;
        return d.keys().hasAll(['title','category','description','status','materialIds','taskTypeIds','photos','sources','reviewedBy','reviewedAt','createdBy','createdAt','updatedBy','updatedAt','revision'])
          && d.keys().hasOnly(['title','category','description','status','materialIds','taskTypeIds','photos','sources','reviewedBy','reviewedAt','createdBy','createdAt','updatedBy','updatedAt','revision'])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 160
          && d.description is string && d.description.size() <= 50000
          && d.category is string && d.status in ['Draft','Reviewed','Archived']
          && d.materialIds is list && d.materialIds.size() <= 500
          && d.taskTypeIds is list && d.taskTypeIds.size() <= 500
          && d.photos is list && d.photos.size() <= 40
          && d.sources is list && d.sources.size() <= 30
          && d.revision is int && d.updatedBy == request.auth.uid
          && d.createdAt is string && d.updatedAt is string
          && (d.status != 'Reviewed' || (d.reviewedBy is string && d.reviewedBy.size() > 0 && d.reviewedAt is string && d.reviewedAt.size() > 0 && d.sources.size() > 0));
      }
      allow read: if isAuth();
      allow create: if isAdmin() && validGuide() && request.resource.data.createdBy == request.auth.uid && request.resource.data.revision == 1;
      allow update: if isAdmin() && validGuide() && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.revision == resource.data.revision + 1;
      // Archive preserves identifiers and existing task links.
    }
